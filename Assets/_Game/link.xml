<!--
  Managed code stripping is Low (smaller IL2CPP binary). Keep whatever is reached by reflection:
  our assemblies (save mapping, SerializeReference), Newtonsoft (save JSON), Localization smart strings
  and the LevelPlay bridge.
-->
<linker>
  <assembly fullname="FF.Core" preserve="all" />
  <assembly fullname="FF.Data" preserve="all" />
  <assembly fullname="FF.Gameplay" preserve="all" />
  <assembly fullname="FF.AI" preserve="all" />
  <assembly fullname="FF.Save" preserve="all" />
  <assembly fullname="FF.UI" preserve="all" />
  <assembly fullname="FF.Ads" preserve="all" />
  <assembly fullname="Newtonsoft.Json" preserve="all" />
  <assembly fullname="Unity.Localization" preserve="all" />
  <assembly fullname="Unity.Services.LevelPlay" preserve="all" />
</linker>
