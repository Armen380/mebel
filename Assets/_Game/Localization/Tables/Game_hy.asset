      m_Items: []
  - m_Id: 300933147
    m_Localized: "\u0531\u0580\u0561\u0563 \u0567 \u0587 \u0577\u0561\u057F \u0567 \u057F\u0561\u0576\u0578\u0582\u0574\u0589 \u053B\u0576\u0584\u0576 \u0567 \u0570\u0561\u057D\u056F\u0561\u0576\u0578\u0582\u0574, \u0569\u0565 \u0578\u0580\u057F\u0565\u0572 \u056B\u0576\u0579 \u0567 \u057A\u0561\u056F\u0561\u057D\u0578\u0582\u0574 (\u0564\u0561\u057F\u0561\u0580\u056F \u0564\u0561\u0580\u0561\u056F, \u057D\u057A\u0561\u057D\u0578\u0572 \u0562\u0565\u057C\u0576\u0561\u057F\u0561\u0580, \u056F\u0561\u0576\u0563\u0576\u0561\u056E \u0563\u0578\u0580\u056E\u0561\u0580\u0561\u0576), \u0587 \u0561\u057C\u0561\u057B\u056B\u0576\u0568 \u0564\u0561 \u0567 \u0561\u0576\u0578\u0582\u0574"
