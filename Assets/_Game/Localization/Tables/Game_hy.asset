    m_Localized: "\u054F\u0561\u056D\u057F\u0561\u056F\u0576\u0565\u0580\u0568 \u057F\u0561\u0576\u0578\u0582\u0574 \u0567 \u0563\u0578\u0580\u056E\u0561\u0580\u0561\u0576\u0576\u0565\u0580, \u056F\u0561\u0570\u0578\u0582\u0575\u0584\u0568\u055D \u056D\u0561\u0576\u0578\u0582\u0569 \u056F\u0561\u0574 \u0562\u0565\u057C\u0576\u0561\u057F\u0561\u0580"
    m_Metadata:
      m_Items: []
