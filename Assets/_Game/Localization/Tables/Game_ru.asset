    m_Metadata:
      m_Items: []
  - m_Id: 296738823
    m_Localized: "\u0422\u0435\u0441\u0442: +25 \u0443\u0440., +250K \u058F"
    m_Metadata:
      m_Items: []
  - m_Id: 296738824
    m_Localized: "\u041D\u043E\u0432\u0430\u044F \u0438\u0433\u0440\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 296738825
    m_Localized: "\u0412\u0441\u0451 \u0431\u0443\u0434\u0435\u0442 \u0443\u0434\u0430\u043B\u0435\u043D\u043E. \u041D\u0430\u0436\u043C\u0438 \u0435\u0449\u0451 \u0440\u0430\u0437"
    m_Metadata:
      m_Items: []
  - m_Id: 296738826
    m_Localized: "WASD \u0438\u043B\u0438 \u0441\u0442\u0440\u0435\u043B\u043A\u0438 \xB7 Q: \u0431\u0440\u043E\u0441\u0438\u0442\u044C \xB7 \u0422\u0435\u043B\u0435\u0444\u043E\u043D: \u0432\u0435\u0434\u0438 \u043F\u0430\u043B\u044C\u0446\u0435\u043C"
