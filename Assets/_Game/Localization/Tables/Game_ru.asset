  - m_Id: 300933136
    m_Localized: "\u0412\u043C\u0435\u0441\u0442\u0438\u043C\u043E\u0441\u0442\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 300933137
    m_Localized: "\u041D\u043E\u0441\u0438 \u0431\u043E\u043B\u044C\u0448\u0435 \u043F\u0440\u0435\u0434\u043C\u0435\u0442\u043E\u0432 \u0437\u0430 \u0440\u0430\u0437"
    m_Metadata:
      m_Items: []
  - m_Id: 300933138
    m_Localized: "\u0421\u043A\u043E\u0440\u043E\u0441\u0442\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 300933139
    m_Localized: "\u0425\u043E\u0434\u0438 \u0431\u044B\u0441\u0442\u0440\u0435\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 300933140
    m_Localized: "\u041E\u0441\u0442\u0440\u044B\u0439 \u0442\u043E\u043F\u043E\u0440"
    m_Metadata:
      m_Items: []
  - m_Id: 300933141
    m_Localized: "\u0420\u0443\u0431\u0438 \u0434\u0435\u0440\u0435\u0432\u044C\u044F \u0438 \u043A\u0430\u043C\u043D\u0438 \u0431\u044B\u0441\u0442\u0440\u0435\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 300933142
    m_Localized: "\u041B\u0435\u0441\u043E\u0440\u0443\u0431"
    m_Metadata:
      m_Items: []
  - m_Id: 300933143
    m_Localized: "\u0420\u0443\u0431\u0438\u0442 \u0434\u0435\u0440\u0435\u0432\u044C\u044F \u0438 \u043D\u043E\u0441\u0438\u0442 \u0431\u0440\u0451\u0432\u043D\u0430 \u043D\u0430 \u043B\u0435\u0441\u043E\u043F\u0438\u043B\u043A\u0443"
    m_Metadata:
      m_Items: []
  - m_Id: 300933144
    m_Localized: "\u0413\u0440\u0443\u0437\u0447\u0438\u043A"
    m_Metadata:
      m_Items: []
  - m_Id: 300933145
    m_Localized: "\u041D\u043E\u0441\u0438\u0442 \u0434\u043E\u0441\u043A\u0438 \u043D\u0430 \u0444\u0430\u0431\u0440\u0438\u043A\u0438, \u043C\u0435\u0431\u0435\u043B\u044C \u0432 \u043C\u0430\u0433\u0430\u0437\u0438\u043D \u0438\u043B\u0438 \u0432 \u0433\u0440\u0443\u0437\u043E\u0432\u0438\u043A\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 300933146
    m_Localized: "\u0420\u043E\u0431\u043E\u0442-\u0433\u0440\u0443\u0437\u0447\u0438\u043A"
    m_Metadata:
      m_Items: []
  - m_Id: 300933147
    m_Localized: "\u0411\u044B\u0441\u0442\u0440\u044B\u0439 \u0438 \u043C\u043D\u043E\u0433\u043E \u043D\u043E\u0441\u0438\u0442. \u0421\u0430\u043C \u043F\u043E\u043D\u0438\u043C\u0430\u0435\u0442, \u0447\u0435\u0433\u043E \u043D\u0435 \u0445\u0432\u0430\u0442\u0430\u0435\u0442 (\u043F\u0443\u0441\u0442\u0430\u044F \u043F\u043E\u043B\u043A\u0430, \u0436\u0434\u0443\u0449\u0438\u0439 \u0433\u0440\u0443\u0437\u043E\u0432\u0438\u043A, \u043F\u0440\u043E\u0441\u0442\u0430\u0438\u0432\u0430\u044E\u0449\u0430\u044F \u0444\u0430\u0431\u0440\u0438\u043A\u0430), \u0438 \u0434\u0435\u043B\u0430\u0435\u0442 \u044D\u0442\u043E \u043F\u0435\u0440\u0432\u044B\u043C"
    m_Metadata:
      m_Items: []
  - m_Id: 300933148
    m_Localized: "\u0428\u0430\u0445\u0442\u0451\u0440"
    m_Metadata:
      m_Items: []
  - m_Id: 300933149
    m_Localized: "\u0414\u043E\u0431\u044B\u0432\u0430\u0435\u0442 \u0433\u043B\u0438\u043D\u0443 \u0438 \u0436\u0435\u043B\u0435\u0437\u043E \u0438 \u043D\u043E\u0441\u0438\u0442 \u043D\u0430 \u0444\u0430\u0431\u0440\u0438\u043A\u0438 \u0441\u0430\u043D\u0442\u0435\u0445\u043D\u0438\u043A\u0438 \u0438 \u0441\u0442\u0440\u043E\u0439\u043C\u0430\u0442\u0435\u0440\u0438\u0430\u043B\u043E\u0432"
    m_Metadata:
      m_Items: []
  - m_Id: 300933150
    m_Localized: "\u041A\u0430\u0441\u0441\u0438\u0440"
    m_Metadata:
      m_Items: []
  - m_Id: 300933151
    m_Localized: "\u0421\u0442\u043E\u0438\u0442 \u0443 \u0441\u0432\u043E\u0431\u043E\u0434\u043D\u043E\u0439 \u043A\u0430\u0441\u0441\u044B \u0438 \u043E\u0431\u0441\u043B\u0443\u0436\u0438\u0432\u0430\u0435\u0442 \u043F\u043E\u043A\u0443\u043F\u0430\u0442\u0435\u043B\u0435\u0439"
    m_Metadata:
      m_Items: []
  - m_Id: 300933152
    m_Localized: "\u041C\u0435\u0440\u0447\u0435\u043D\u0434\u0430\u0439\u0437\u0435\u0440"
    m_Metadata:
      m_Items: []
  - m_Id: 300933153
    m_Localized: "\u041D\u043E\u0441\u0438\u0442 \u0433\u043E\u0442\u043E\u0432\u0443\u044E \u043C\u0435\u0431\u0435\u043B\u044C \u0441 \u0444\u0430\u0431\u0440\u0438\u043A \u043D\u0430 \u043F\u043E\u043B\u043A\u0438 \u043C\u0430\u0433\u0430\u0437\u0438\u043D\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 300933154
    m_Localized: "\u041C\u0435\u043D\u0435\u0434\u0436\u0435\u0440"
    m_Metadata:
      m_Items: []
  - m_Id: 300933155
    m_Localized: "\u0421\u043E\u0431\u0438\u0440\u0430\u0435\u0442 \u0434\u0435\u043D\u044C\u0433\u0438 \u0441\u043E \u0432\u0441\u0435\u0445 \u043A\u0430\u0441\u0441 \u043D\u0430 \u0442\u0432\u043E\u0439 \u0441\u0447\u0451\u0442"
    m_Metadata:
      m_Items: []
  - m_Id: 300933156
    m_Localized: "\u041A\u043E\u043D\u0441\u0443\u043B\u044C\u0442\u0430\u043D\u0442"
    m_Metadata:
      m_Items: []
  - m_Id: 300933157
    m_Localized: "\u041F\u043E\u043A\u0443\u043F\u0430\u0442\u0435\u043B\u0438 \u0442\u0435\u0440\u043F\u0435\u043B\u0438\u0432\u0435\u0435 \u0438 \u043F\u043B\u0430\u0442\u044F\u0442 \u0431\u043E\u043B\u044C\u0448\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 300933158
    m_Localized: "\u0420\u0435\u043A\u043B\u0430\u043C\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 300933159
    m_Localized: "\u041F\u043E\u043A\u0443\u043F\u0430\u0442\u0435\u043B\u0438 \u043F\u0440\u0438\u0445\u043E\u0434\u044F\u0442 \u0447\u0430\u0449\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 300933160
