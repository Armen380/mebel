    m_Localized: "\u041F\u043E\u0441\u0442\u0430\u0432\u044C \u0441\u0442\u0443\u043B\u044C\u044F \u043D\u0430 \u043F\u043E\u043B\u043A\u0443 \u043C\u0430\u0433\u0430\u0437\u0438\u043D\u0430"
