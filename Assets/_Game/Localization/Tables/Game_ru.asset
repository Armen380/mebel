    m_Localized: "\u0412\u0441\u0442\u0430\u043D\u044C \u0443 \u043A\u0430\u0441\u0441\u044B, \u043E\u0431\u0441\u043B\u0443\u0436\u0438 \u043F\u043E\u043A\u0443\u043F\u0430\u0442\u0435\u043B\u044F \u0438 \u0437\u0430\u0431\u0435\u0440\u0438 \u0434\u0435\u043D\u044C\u0433\u0438"
