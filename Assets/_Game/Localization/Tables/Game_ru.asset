      m_Items: []
  - m_Id: 296738833
    m_Localized: "\u0412\u044B\u0431\u0440\u043E\u0441\u0438\u0442\u044C \u0442\u043E, \u0447\u0442\u043E \u043D\u0435\u0441\u0451\u0448\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 296738834
    m_Localized: "\u0411\u0430\u043B\u0430\u043D\u0441: {v} \u058F"
    m_Metadata:
      m_Items:
      - rid: 7053691049560244358
  - m_Id: 300933120
    m_Localized: "\u0423\u043B\u0443\u0447\u0448\u0435\u043D\u0438\u044F \u0444\u0430\u0431\u0440\u0438\u043A, \u0433\u0440\u0443\u0437\u043E\u0432\u0438\u043A\u043E\u0432, \u043F\u0430\u0440\u043A\u043E\u0432\u043A\u0438 \u0438 \u043A\u0430\u0441\u0441 \u2014 \u044D\u0442\u043E <b>\u0436\u0451\u043B\u0442\u044B\u0435 \u043F\u043B\u043E\u0449\u0430\u0434\u043A\u0438</b> \u043D\u0430 \u0437\u0435\u043C\u043B\u0435. \u0412\u0441\u0442\u0430\u043D\u044C \u043D\u0430 \u043F\u043B\u043E\u0449\u0430\u0434\u043A\u0443, \u0438 \u0434\u0435\u043D\u044C\u0433\u0438 \u043F\u043E\u0439\u0434\u0443\u0442 \u0442\u0443\u0434\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 300933121
    m_Localized: "\u041C\u0410\u041A\u0421"
    m_Metadata:
      m_Items: []
