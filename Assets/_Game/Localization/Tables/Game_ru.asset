  m_TableData:
  - m_Id: 288350208
    m_Localized: "\u041C\u0435\u0431\u0435\u043B\u044C\u043D\u0430\u044F \u0444\u0430\u0431\u0440\u0438\u043A\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 296738816
    m_Localized: "\u041C\u0435\u0431\u0435\u043B\u044C\u043D\u0430\u044F <em>\u0444\u0430\u0431\u0440\u0438\u043A\u0430</em>"
    m_Metadata:
      m_Items: []
  - m_Id: 296738817
    m_Localized: "\u041F\u0440\u043E\u0442\u043E\u0442\u0438\u043F \xB7 v0.3"
    m_Metadata:
      m_Items: []
  - m_Id: 296738818
    m_Localized: "\u0420\u0443\u0431\u0438 \u0434\u0435\u0440\u0435\u0432\u044C\u044F, \u043F\u0438\u043B\u0438 \u0434\u043E\u0441\u043A\u0438, \u0434\u0435\u043B\u0430\u0439 \u043C\u0435\u0431\u0435\u043B\u044C \u0438 \u043F\u0440\u043E\u0434\u0430\u0432\u0430\u0439. \u041F\u043E\u0432\u044B\u0448\u0430\u0439 \u0443\u0440\u043E\u0432\u0435\u043D\u044C, \u0447\u0442\u043E\u0431\u044B \u043E\u0442\u043A\u0440\u044B\u0432\u0430\u0442\u044C \u043D\u043E\u0432\u044B\u0435 \u0444\u0430\u0431\u0440\u0438\u043A\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 296738819
    m_Localized: "\u0412\u044B\u0431\u0435\u0440\u0438 \u043F\u0435\u0440\u0441\u043E\u043D\u0430\u0436\u0430"
    m_Metadata:
      m_Items: []
